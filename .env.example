# Optional destination for the booking CTA. If empty, it scrolls to the contact form.
VITE_BOOKING_URL=

# Lead delivery: use one of the following.
# Recommended: a webhook endpoint (Formspree, Make, Zapier, your API, etc.)
VITE_FORM_ENDPOINT=

# Fallback: WhatsApp number with country code, digits only (Mexico example: 52...)
VITE_WHATSAPP_NUMBER=

# Fallback: email address for mailto submission
VITE_CONTACT_EMAIL=
